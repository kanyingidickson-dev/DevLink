### Stats API

Create `src/app/api/profile/analytics/stats/route.ts`:

```ts
import { prisma } from "@/src/lib/prisma";
import { getServerSession } from "next-auth";
import { authOptions } from "@/src/utils/authOptions";
import { NextResponse } from "next/server";

export async function GET() {
  const session = await getServerSession(authOptions);
  if (!session) return NextResponse.json({}, { status: 401 });

  const userId = (session as any).userId;

  const profile = await prisma.profile.findUnique({
    where: { userId }
  });

  const views = await prisma.analytics.count({
    where: { profileId: profile!.id, event: "view" }
  });

  const clicks = await prisma.analytics.count({
    where: { profileId: profile!.id, event: "click" }
  });

  return NextResponse.json({ views, clicks });
}
```

